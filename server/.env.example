# Beacon Detector — bridge environment.
# Copy to `.env` and export it before running the bridge, e.g.:
#   set -a; . ./.env; set +a; pnpm bridge
# Never commit `.env`.

# Bind address. 127.0.0.1 is correct when Cloudflare Tunnel runs on the same
# machine (cloudflared dials localhost). Use 0.0.0.0 only for a direct LAN host.
BRIDGE_HOST=127.0.0.1
BRIDGE_PORT=8787

# Shared secret required in the first `auth` WS frame.
# Generate one with: openssl rand -hex 32
# Leave empty ONLY for local development.
BRIDGE_AUTH_TOKEN=

# Comma-separated origins allowed to open the WebSocket. Wildcards are supported
# per segment, e.g. https://*.beacon-detector.pages.dev
# Include the Cloudflare Pages production URL, preview URLs, and local dev.
BRIDGE_ALLOWED_ORIGINS=https://beacon-detector.pages.dev,https://*.beacon-detector.pages.dev,http://localhost:5173
